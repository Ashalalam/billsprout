# ============================================================================
# LIFESPROUT / BILLSPROUT - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials to version control!

# Application Info
APP_NAME=BillSprout
APP_SUBTITLE=Smart ERP & Billing System
COMPANY_NAME=LIFESPROUT Care
APP_VERSION=v1.3.0+1

# ============================================================================
# SUPABASE BACKEND CONFIGURATION
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# PAYPAL CONFIGURATION (PRODUCTION)
# ============================================================================
# Get your production credentials from: https://developer.paypal.com/dashboard/
# 
# Steps to get credentials:
# 1. Go to https://developer.paypal.com/dashboard/
# 2. Log in with your PayPal Business account
# 3. Go to "Apps & Credentials"
# 4. Under "Live" tab, create a new app or use existing
# 5. Copy the Client ID and Secret
# 
# For PayPal.Me:
# 1. Go to https://www.paypal.me/
# 2. Create/claim your PayPal.Me link
# 3. Use the username from your link (e.g., paypal.me/YourUsername)

PAYPAL_CLIENT_ID=your-production-client-id-here
PAYPAL_CLIENT_SECRET=your-production-client-secret-here
PAYPAL_MERCHANT_ID=your-merchant-id-here
PAYPAL_ME_USERNAME=your-paypal-me-username

# PayPal Environment: false for production, true for sandbox/testing
PAYPAL_SANDBOX_MODE=false

# ============================================================================
# DEMO CREDENTIALS (for testing without backend)
# ============================================================================
SUPER_ADMIN_EMAIL=superadmin@billsprout.online
STORE_ADMIN_EMAIL=admin@lifesproutcare.com
CUSTOMER_EMAIL=patient@lifesproutcare.com
PHARMACIST_PIN=1234

# ============================================================================
# SUPPORT CONTACT INFORMATION
# ============================================================================
CUSTOMER_CARE_EMAIL=info@lifesproutcare.com
TECHNICAL_SUPPORT_EMAIL=Support@billsprout.online
WHATSAPP_SUPPORT_NUMBER=+44 7747 571513
WHATSAPP_LINK=https://wa.me/447747571513
