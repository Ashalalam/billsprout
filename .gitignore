#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Exclude all build artifacts EXCEPT the Flutter web output (served by Vercel)
/build/
!/build/web/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Credentials — never commit. Contains Supabase keys.
.env
.env.*
!.env.example

# Node tooling used by the database verification scripts in tool/
node_modules/
package-lock.json

