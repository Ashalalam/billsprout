{
  "buildCommand": "bash install_flutter.sh && flutter clean && flutter pub get && flutter build web --release --web-renderer html --base-href /",
  "outputDirectory": "build/web",
  "installCommand": "echo 'Flutter will be installed via buildCommand'",
  "rewrites": [
    {
      "source": "/((?!main\\.dart\\.js|flutter\\.js|flutter_service_worker\\.js|assets/.*|canvaskit/.*|icons/.*|favicon\\..*|manifest\\.json|env-config\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/main.dart.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/flutter.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/canvaskit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}